# Resend API key, used by the contact form (app/api/contact/route.ts)
RESEND_API_KEY=

# Sender for contact form emails. Must be on a domain verified in Resend,
# e.g. "Poleni Kontakt <kontakt@poleni.dk>"
CONTACT_FROM_EMAIL=

# Inbox that receives contact form submissions
CONTACT_TO_EMAIL=

# Calendly event URL embedded on the home and contact pages,
# e.g. https://calendly.com/<user>/30min
NEXT_PUBLIC_CALENDLY_URL=
